+
+func TestParseChain(t *testing.T) {
+	t.Parallel()
+	for _, value := range []string{
+		"", "http://proxy:8088", "http://proxy:8088,http://100.100.100.100:3128", "http://[::1]:3128",
+	} {
+		t.Run(value, func(t *testing.T) {
+			t.Parallel()
+			_, err := edgeproxy.ParseChain(value)
+			require.NoError(t, err)
+		})
+	}
+	for _, value := range []string{
+		" ", "https://proxy:443", "http://proxy", "http://proxy:0", "http://proxy:65536",
+		"http://proxy:8088/route", "http://proxy:8088?token=secret", "http://proxy:8088#fragment",
+		"http://user:secret@proxy:8088", "http://proxy:8088,", "http://proxy:8088,http://bad:%",
+	} {
+		t.Run(value, func(t *testing.T) {
+			t.Parallel()
+			_, err := edgeproxy.ParseChain(value)
+			require.Error(t, err)
+			require.NotContains(t, err.Error(), "secret")
+		})
+	}
+}
+
+// connectProxy forwards an authorized loopback target, modeling both the runtime
+// sidecar and the tailnet Squid relay without accessing any external service.
+func connectProxy(t *testing.T, target string) *httptest.Server {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodConnect || request.Host != target {
+			t.Errorf("unexpected proxy request: %s %s", request.Method, request.Host)
+			w.WriteHeader(http.StatusForbidden)
+			return
+		}
+		upstream, err := net.DialTimeout("tcp", target, time.Second)
+		if err != nil {
+			t.Errorf("connect to fixture: %v", err)
+			w.WriteHeader(http.StatusBadGateway)
+			return
+		}
+		defer func() { _ = upstream.Close() }()
+		conn, buffered, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Errorf("hijack proxy connection: %v", err)
+			return
+		}
+		defer func() { _ = conn.Close() }()
+		if _, err := io.WriteString(conn, "HTTP/1.1 200 Connection Established\r\n\r\n"); err != nil {
+			return
+		}
+		copied := make(chan struct{})
+		go func() {
+			_, _ = io.Copy(upstream, buffered.Reader)
+			_ = upstream.Close()
+			close(copied)
+		}()
+		_, _ = io.Copy(conn, upstream)
+		_ = conn.Close()
+		<-copied
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+
+func TestTwoHopsPreserveTLSIdentityAndData(t *testing.T) {
+	t.Parallel()
+	edge := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = io.WriteString(w, "reached edge")
+	}))
+	defer edge.Close()
+	target := strings.TrimPrefix(edge.URL, "https://")
+	relay := connectProxy(t, target)
+	sidecar := connectProxy(t, strings.TrimPrefix(relay.URL, "http://"))
+	chain, err := edgeproxy.ParseChain(sidecar.URL + "," + relay.URL)
+	require.NoError(t, err)
+	address, err := net.ResolveTCPAddr("tcp", target)
+	require.NoError(t, err)
+	roots := x509.NewCertPool()
+	roots.AddCert(edge.Certificate())
+	tlsConfig, err := cfdcrypto.TLSConfigWithCurvePreferences(
+		&tls.Config{RootCAs: roots, ServerName: "example.com", MinVersion: tls.VersionTLS12},
+		features.PostQuantumPrefer)
+	require.NoError(t, err)
+	conn, err := edgediscovery.DialEdgeWithProxy(t.Context(), 3*time.Second,
+		tlsConfig, address, nil, chain)
+	require.NoError(t, err)
+	defer func() { _ = conn.Close() }()
+	state := conn.(*tls.Conn).ConnectionState()
+	require.Equal(t, "example.com", state.ServerName)
+	require.NotEmpty(t, state.VerifiedChains)
+	_, err = fmt.Fprintf(conn, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
+	require.NoError(t, err)
+	response, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	require.NoError(t, err)
+	defer func() { _ = response.Body.Close() }()
+	body, err := io.ReadAll(response.Body)
+	require.NoError(t, err)
+	require.Equal(t, "reached edge", string(body))
+}
