+func TestRejectedCONNECTDoesNotFallBackToDirect(t *testing.T) {
+	t.Parallel()
+	direct := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		t.Error("proxy rejection must not reach the edge directly")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer direct.Close()
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusForbidden)
+	}))
+	defer proxy.Close()
+	chain, err := edgeproxy.ParseChain(proxy.URL)
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	conn, err := chain.DialContext(ctx, &net.Dialer{}, strings.TrimPrefix(direct.URL, "http://"))
+	require.ErrorContains(t, err, "HTTP 403")
+	require.Nil(t, conn)
+}
+
+func TestCancelledCONNECTClosesSocket(t *testing.T) {
+	t.Parallel()
+	requested := make(chan struct{})
+	closed := make(chan struct{})
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Errorf("hijack: %v", err)
+			return
+		}
+		defer func() { _ = conn.Close() }()
+		close(requested)
+		_, _ = io.Copy(io.Discard, conn)
+		close(closed)
+	}))
+	defer proxy.Close()
+	chain, err := edgeproxy.ParseChain(proxy.URL)
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	go func() {
+		<-requested
+		cancel()
+	}()
+	conn, err := chain.DialContext(ctx, &net.Dialer{}, "example.invalid:7844")
+	require.ErrorIs(t, err, context.Canceled)
+	require.Nil(t, conn)
+	select {
+	case <-closed:
+	case <-time.After(3 * time.Second):
+		t.Fatal("cancelled CONNECT leaked its socket")
+	}
+}
