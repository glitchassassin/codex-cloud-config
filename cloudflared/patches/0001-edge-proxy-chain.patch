+
+func TestEdgeProxyProtocolSelection(t *testing.T) {
+	t.Parallel()
+	for _, test := range []struct {
+		name     string
+		chain    string
+		protocol string
+		want     string
+		wantErr  bool
+	}{
+		{"direct auto", "", "auto", "auto", false},
+		{"direct quic", "", "quic", "quic", false},
+		{"proxy auto", "http://proxy:8088", "auto", "http2", false},
+		{"proxy http2", "http://proxy:8088", "http2", "http2", false},
+		{"proxy quic", "http://proxy:8088", "quic", "", true},
+		{"invalid proxy", "https://proxy:8088", "http2", "", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			set := flag.NewFlagSet("proxy-test", flag.ContinueOnError)
+			set.String(flags.EdgeProxyChain, test.chain, "")
+			set.String(flags.Protocol, test.protocol, "")
+			_, protocol, err := edgeProxySettings(cli.NewContext(cli.NewApp(), set, nil))
+			if test.wantErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, test.want, protocol)
+		})
+	}
+}
+
+// A child process isolates net/http's cached environment proxy configuration.
+// The fake provisioning hostname must reach the proxy without local DNS or a
+// direct connection, and receives a deliberate rejection before starting a tunnel.
+func TestQuickTunnelUsesEnvironmentProxy(t *testing.T) {
+	if os.Getenv("CLOUDFLARED_PROXY_TEST_CHILD") == "1" {
+		buildInfo = cliutil.GetBuildInfo("", "proxy-test")
+		set := flag.NewFlagSet("quick-test", flag.ContinueOnError)
+		set.String(flags.EdgeProxyChain, "", "")
+		set.String(flags.Protocol, "auto", "")
+		set.String("quick-service", "http://provisioning.invalid", "")
+		context := cli.NewContext(cli.NewApp(), set, nil)
+		log := zerolog.New(io.Discard)
+		err := RunQuickTunnel(&subcommandContext{c: context, log: &log})
+		require.ErrorContains(t, err, "fixture proxy reached")
+		return
+	}
+	t.Parallel()
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodPost || request.URL.String() != "http://provisioning.invalid/tunnel" {
+			t.Errorf("unexpected provisioning request: %s %s", request.Method, request.URL)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusBadRequest)
+		_, _ = io.WriteString(w, `{"success":false,"errors":[{"code":1,"message":"fixture proxy reached"}]}`)
+	}))
+	defer proxy.Close()
+	command := exec.CommandContext(t.Context(), os.Args[0], "-test.run=^TestQuickTunnelUsesEnvironmentProxy$")
+	for _, entry := range os.Environ() {
+		name, _, _ := strings.Cut(entry, "=")
+		switch strings.ToUpper(name) {
+		case "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "CLOUDFLARED_PROXY_TEST_CHILD":
+			continue
+		}
+		command.Env = append(command.Env, entry)
+	}
+	command.Env = append(command.Env, "HTTP_PROXY="+proxy.URL, "NO_PROXY=", "CLOUDFLARED_PROXY_TEST_CHILD=1")
+	output, err := command.CombinedOutput()
+	require.NoError(t, err, "%s", output)
+}
