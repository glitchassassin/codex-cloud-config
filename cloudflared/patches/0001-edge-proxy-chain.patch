diff --git a/edgeproxy/chain.go b/edgeproxy/chain.go
new file mode 100644
index 0000000..5f0e680
--- /dev/null
+++ b/edgeproxy/chain.go
@@ -0,0 +1,130 @@
+// Package edgeproxy connects to tunnel edges through explicit HTTP CONNECT hops.
+package edgeproxy
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Chain is an immutable ordered list of HTTP CONNECT proxy authorities.
+// It is safe to share between concurrent edge connection attempts.
+type Chain struct {
+	hops []string
+}
+
+// ParseChain accepts comma-separated http://host:port URLs, in dialing order.
+// Authentication and HTTPS proxy listeners are deliberately unsupported. The
+// relay is authenticated by tailnet policy; the edge retains its original TLS.
+func ParseChain(value string) (*Chain, error) {
+	if value == "" {
+		return nil, nil
+	}
+	chain := &Chain{}
+	for index, part := range strings.Split(value, ",") {
+		proxy, err := url.Parse(strings.TrimSpace(part))
+		if err != nil {
+			return nil, fmt.Errorf("invalid edge proxy URL at hop %d", index+1)
+		}
+		if proxy.Scheme != "http" || proxy.Hostname() == "" || proxy.Port() == "" ||
+			proxy.User != nil || proxy.Path != "" || proxy.RawQuery != "" ||
+			proxy.ForceQuery || proxy.Fragment != "" || proxy.Opaque != "" {
+			return nil, fmt.Errorf("edge proxy hop %d must be an http://host:port URL without credentials, path, query, or fragment", index+1)
+		}
+		port, err := strconv.Atoi(proxy.Port())
+		if err != nil || port < 1 || port > 65535 {
+			return nil, fmt.Errorf("invalid edge proxy port at hop %d", index+1)
+		}
+		chain.hops = append(chain.hops, proxy.Host)
+	}
+	return chain, nil
+}
+
+// DialContext dials the first proxy, tunnels to each subsequent proxy, then
+// tunnels to address. Errors never fall back to a direct connection.
+func (c *Chain) DialContext(ctx context.Context, dialer *net.Dialer, address string) (result net.Conn, err error) {
+	if c == nil {
+		return dialer.DialContext(ctx, "tcp", address)
+	}
+	if len(c.hops) == 0 {
+		return nil, fmt.Errorf("edge proxy chain has no hops")
+	}
+	conn, err := dialer.DialContext(ctx, "tcp", c.hops[0])
+	if err != nil {
+		return nil, fmt.Errorf("dial edge proxy hop 1: %w", err)
+	}
+	// Deadlines handle timeouts; cancellation also closes a stalled CONNECT.
+	stopCancellation := context.AfterFunc(ctx, func() { _ = conn.Close() })
+	defer stopCancellation()
+	defer func() {
+		if err != nil {
+			_ = conn.Close()
+		}
+	}()
+	if deadline, ok := ctx.Deadline(); ok {
+		if err = conn.SetDeadline(deadline); err != nil {
+			return nil, fmt.Errorf("set edge proxy deadline: %w", err)
+		}
+	}
+	current := conn
+	for index := range c.hops {
+		target := address
+		if index+1 < len(c.hops) {
+			target = c.hops[index+1]
+		}
+		current, err = connect(current, target)
+		if err != nil {
+			if ctx.Err() != nil {
+				err = ctx.Err()
+			}
+			return nil, fmt.Errorf("edge proxy hop %d CONNECT failed: %w", index+1, err)
+		}
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err = conn.SetDeadline(time.Time{}); err != nil {
+		return nil, fmt.Errorf("clear edge proxy deadline: %w", err)
+	}
+	return current, nil
+}
+
+func connect(conn net.Conn, address string) (net.Conn, error) {
+	request := &http.Request{
+		Method: http.MethodConnect,
+		URL:    &url.URL{Host: address},
+		Host:   address,
+		Header: make(http.Header),
+	}
+	if err := request.Write(conn); err != nil {
+		return nil, fmt.Errorf("write CONNECT request: %w", err)
+	}
+	reader := bufio.NewReader(conn)
+	response, err := http.ReadResponse(reader, request) //nolint:bodyclose // CONNECT transfers socket ownership; the caller closes it on rejection.
+	if err != nil {
+		return nil, fmt.Errorf("read CONNECT response: %w", err)
+	}
+	if response.StatusCode != http.StatusOK {
+		// The caller closes the socket. Reading or closing a rejection body can
+		// otherwise block, and its contents may contain private information.
+		return nil, fmt.Errorf("proxy returned HTTP %d", response.StatusCode)
+	}
+	// Do not close a successful CONNECT response body: the socket is the tunnel.
+	// Preserve any tunnel bytes read ahead while parsing the HTTP headers.
+	return &bufferedConn{Conn: conn, reader: reader}, nil
+}
+
+type bufferedConn struct {
+	net.Conn
+	reader *bufio.Reader
+}
+
+func (c *bufferedConn) Read(buffer []byte) (int, error) {
+	return c.reader.Read(buffer)
+}
