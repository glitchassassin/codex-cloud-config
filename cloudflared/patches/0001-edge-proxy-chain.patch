+func TestProxyDoesNotDisableCertificateVerification(t *testing.T) {
+	t.Parallel()
+	edge := httptest.NewTLSServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	defer edge.Close()
+	target := strings.TrimPrefix(edge.URL, "https://")
+	relay := connectProxy(t, target)
+	chain, err := edgeproxy.ParseChain(relay.URL)
+	require.NoError(t, err)
+	address, err := net.ResolveTCPAddr("tcp", target)
+	require.NoError(t, err)
+	roots := x509.NewCertPool()
+	roots.AddCert(edge.Certificate())
+	conn, err := edgediscovery.DialEdgeWithProxy(t.Context(), 3*time.Second,
+		&tls.Config{RootCAs: roots, ServerName: "wrong.invalid", MinVersion: tls.VersionTLS12}, address, nil, chain)
+	require.ErrorContains(t, err, "certificate")
+	require.Nil(t, conn)
+}
+
+func TestCONNECTPreservesReadAheadBytes(t *testing.T) {
+	t.Parallel()
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Errorf("hijack: %v", err)
+			return
+		}
+		defer func() { _ = conn.Close() }()
+		_, _ = io.WriteString(conn, "HTTP/1.1 200 OK\r\n\r\nfirst tunnel bytes")
+	}))
+	defer proxy.Close()
+	chain, err := edgeproxy.ParseChain(proxy.URL)
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	conn, err := chain.DialContext(ctx, &net.Dialer{}, "example.invalid:7844")
+	require.NoError(t, err)
+	defer func() { _ = conn.Close() }()
+	body, err := io.ReadAll(conn)
+	require.NoError(t, err)
+	require.Equal(t, "first tunnel bytes", string(body))
+}
